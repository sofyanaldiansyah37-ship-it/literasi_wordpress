{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Amber Terminal",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#0d0b04"
				},
				{
					"slug": "base-2",
					"name": "Base 2",
					"color": "#080600"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#171204"
				},
				{
					"slug": "surface-2",
					"name": "Surface 2",
					"color": "#1f1806"
				},
				{
					"slug": "surface-3",
					"name": "Surface 3",
					"color": "#0a0800"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#3a2c0a"
				},
				{
					"slug": "border-strong",
					"name": "Border Strong",
					"color": "#5a4410"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#a07c2e"
				},
				{
					"slug": "subtle",
					"name": "Subtle",
					"color": "#d0a445"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#ffe9b0"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast 2",
					"color": "#fff6df"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#ffb300"
				},
				{
					"slug": "accent-contrast",
					"name": "On Accent",
					"color": "#0d0b04"
				},
				{
					"slug": "on-surface",
					"name": "On Surface",
					"color": "#ffd98a"
				},
				{
					"slug": "ink-2",
					"name": "Ink 2",
					"color": "#e8c67a"
				},
				{
					"slug": "accent-strong",
					"name": "Accent Strong",
					"color": "#ffce58"
				},
				{
					"slug": "link-text",
					"name": "Link",
					"color": "#ffb300"
				},
				{
					"slug": "link-hover",
					"name": "Link Hover",
					"color": "#ffce58"
				}
			],
			"gradients": [
				{
					"slug": "fade-up",
					"name": "Fade Up",
					"gradient": "linear-gradient(0deg, #171204 0%, #0d0b04 100%)"
				},
				{
					"slug": "fade-down",
					"name": "Fade Down",
					"gradient": "linear-gradient(180deg, #0d0b04 0%, #171204 100%)"
				},
				{
					"slug": "surface-sheen",
					"name": "Surface Sheen",
					"gradient": "linear-gradient(135deg, #1f1806 0%, #0c0900 100%)"
				},
				{
					"slug": "hairline",
					"name": "Hairline",
					"gradient": "linear-gradient(90deg, transparent, #5a4410, transparent)"
				}
			],
			"duotone": [
				{
					"slug": "gray-duo",
					"name": "Gray Duotone",
					"colors": [
						"#0d0b04",
						"#ffb300"
					]
				}
			]
		},
		"custom": {
			"button": {
				"hoverBg": "var(--wp--preset--color--accent-strong)",
				"hoverInk": "var(--wp--preset--color--base)"
			},
			"color": {
				"focus-ring": "#ffcf4d"
			},
			"radius": {
				"none": "0",
				"sm": "0px",
				"md": "0px",
				"lg": "0px",
				"pill": "0px"
			},
			"ui": {
				"colorScheme": "dark"
			}
		},
		"shadow": {
			"presets": [
				{
					"slug": "sm",
					"name": "Small",
					"shadow": "0 0 8px rgba(255,179,0,0.20)"
				},
				{
					"slug": "md",
					"name": "Medium",
					"shadow": "0 0 12px rgba(255,179,0,0.32), 4px 4px 0 0 #000000"
				},
				{
					"slug": "lg",
					"name": "Large",
					"shadow": "0 0 18px rgba(255,179,0,0.45), 6px 6px 0 0 #000000"
				},
				{
					"slug": "inset",
					"name": "Inset",
					"shadow": "inset 0 0 0 1px #5a4410"
				},
				{
					"slug": "bg",
					"name": "Background",
					"color": "#0d0b04"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#ffe9b0"
				},
				{
					"slug": "ink-3",
					"name": "Ink 3",
					"color": "#9b7f3c"
				}
			]
		}
	},
	"styles": {
		"css": "body{background-color:var(--wp--preset--color--base);background-image:radial-gradient(700px 500px at 0% 0%, rgba(255,179,0,.08), transparent 60%);background-attachment:fixed}a:hover{text-shadow:0 0 8px rgba(255,179,0,.5)}::selection{background:var(--wp--preset--color--accent);color:var(--wp--preset--color--base)}"
	}
}
