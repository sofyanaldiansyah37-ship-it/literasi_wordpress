					"color": "#4a4a52"
				},
				{
					"slug": "link-hover",
					"name": "Link Hover",
					"color": "#38383f"
				},
				{
					"slug": "base",
					"name": "Base",
					"color": "#fbfbfc"
				},
				{
					"slug": "base-2",
					"name": "Base 2",
					"color": "#f3f3f5"
				},
				{
					"slug": "surface-3",
					"name": "Surface 3",
					"color": "#ededf0"
				},
				{
					"slug": "border-strong",
					"name": "Border Strong",
					"color": "#c8c8d0"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#9a9aa3"
				},
				{
					"slug": "subtle",
					"name": "Subtle",
					"color": "#6a6a73"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#26262c"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast 2",
					"color": "#1c1c20"
				},
				{
