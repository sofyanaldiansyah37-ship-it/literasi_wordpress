				"size": "100% 100%, 100% 100%, 48px 48px, 48px 48px",
				"attachment": "fixed",
				"linkGlow": "0 0 8px rgba(255,42,42,.22)",
				"selectionBg": "#ff2a2a",
				"selectionInk": "#050203"
			},
			"nav": {
