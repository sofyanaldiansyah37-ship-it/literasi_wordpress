				"lg": "0",
				"pill": "0"
			},
			"shadow": {
				"sm": "0 0 0 1px #3c1618",
				"md": "4px 4px 0 0 #1a0306",
				"lg": "6px 6px 0 0 #1a0306"
			},
			"page": {
				"pad": "clamp(16px, 4vw, 32px)"
			},
			"section": {
				"rhythm": "clamp(32px, 4vw, 96px)"
			},
