					"tight": "1.1",
					"snug": "1.25",
					"normal": "1.6",
					"relaxed": "1.8"
				},
				"tracking": {
					"tight": "-0.01em",
					"normal": "0",
					"wide": "0.06em"
				}
			},
			"surface": {
